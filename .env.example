# ====================================================================
# SEOULÉA: Environment Configuration
# ====================================================================

# Public Supabase API Settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-Only Supabase Service Role Key (Keep secret! Never prefix with NEXT_PUBLIC)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Site URL for canonical URLs & social metadata
NEXT_PUBLIC_SITE_URL=https://seoulea.com.bd

# Admin Access Bootstrap Token (for initial first admin account generation)
ADMIN_BOOTSTRAP_SECRET=your-secure-bootstrap-secret-phrase
